rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function mySchoolId() {
      return myProfile().schoolId;
    }

    function myRole() {
      return myProfile().role;
    }

    function isSameSchool(schoolId) {
      return isSignedIn() && mySchoolId() == schoolId;
    }

    function isAdmin(schoolId) {
      return isSameSchool(schoolId) && myRole() in ['admin', 'superadmin'];
    }

    function isTeacher(schoolId) {
      return isSameSchool(schoolId) && myRole() == 'teacher';
    }

    function isStudent(schoolId) {
      return isSameSchool(schoolId) && myRole() == 'student';
    }

    // ---- users: a user can read/update only their own profile.
    // Accounts are created either by an admin bulk-generating them for
    // their own school (student/teacher only — never admin/superadmin,
    // so this path can't be used to self-promote), or in future by a
    // trusted backend flow. Role/schoolId are never editable by the
    // owning user afterward. ----
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if request.auth != null
                    && isAdmin(request.resource.data.schoolId)
                    && request.resource.data.role in ['student', 'teacher'];
      allow update: if (isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.schoolId == resource.data.schoolId
                    && request.resource.data.get('admissionNo', null) == resource.data.get('admissionNo', null)
                    && request.resource.data.get('classIds', null) == resource.data.get('classIds', null))
                    // Admins of the same school may update a teacher's own
                    // profile fields (e.g. classIds) after account creation
                    // — this is what lets "assign a class later" work once
                    // a teacher's account already exists. Role/schoolId
                    // still can't be changed this way.
                    || (isAdmin(resource.data.schoolId)
                        && resource.data.role == 'teacher'
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.schoolId == resource.data.schoolId);
      allow delete: if false;
    }

    // ---- schools: publicly readable (needed for the school picker and
    // branding on the login page, before anyone is authenticated). Only
    // admins of that same school can write to it. ----
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin(schoolId);

      // ---- roster_students: admins manage the roster. A student may
      // read only the single roster record that matches their own
      // claimed uid (needed for profile display), never the whole list. ----
      match /roster_students/{admissionNo} {
        allow read: if isAdmin(schoolId)
                    || isTeacher(schoolId)
                    || (isStudent(schoolId) && resource.data.claimedByUid == request.auth.uid);
        allow write: if isAdmin(schoolId);
      }

      match /roster_teachers/{staffId} {
        allow read: if isAdmin(schoolId)
                    || (isTeacher(schoolId) && resource.data.claimedByUid == request.auth.uid);
        allow write: if isAdmin(schoolId);
      }

      match /classes/{classId} {
        allow read: if isSameSchool(schoolId);
        allow write: if isAdmin(schoolId);
      }

      match /subjects/{subjectId} {
        allow read: if isSameSchool(schoolId);
        allow write: if isAdmin(schoolId);
      }

      // ---- results: the core sensitive collection.
      // - Admins: full access within their school.
      // - Teachers: can create/edit only rows for classes they are
      //   assigned to, and only while status is draft/submitted
      //   (never after publish).
      // - Students: can read ONLY their own results, and ONLY once
      //   published. They can never write. ----
      match /results/{resultId} {
        allow read: if isAdmin(schoolId)
                    || isTeacher(schoolId)
                    || (isStudent(schoolId)
                        && resource.data.status == 'published'
                        && resource.data.studentAdmissionNo == myProfile().admissionNo);

        // NOTE: create and update are split on purpose. On create there is
        // no existing document yet, so checking resource.data (the OLD
        // doc) would always fail — that was the original bug: it silently
        // blocked every first-time score entry by a teacher. Create checks
        // request.resource.data (the NEW doc being written) instead.
        allow create: if isAdmin(schoolId)
                    || (isTeacher(schoolId)
                        && request.resource.data.status != 'published'
                        && request.resource.data.classId in myProfile().classIds);

        allow update: if isAdmin(schoolId)
                    || (isTeacher(schoolId)
                        && resource.data.status != 'published'
                        && request.resource.data.classId in myProfile().classIds);

        allow delete: if isAdmin(schoolId);
      }

      match /announcements/{id} {
        allow read: if isSameSchool(schoolId);
        allow write: if isAdmin(schoolId);
      }

      // Class rankings: one doc per student per class/term/session,
      // containing ONLY that student's rank + total class size — never
      // classmates' names or scores. This is deliberately separate from
      // /results so a student's read access can never accidentally leak
      // another student's data while computing their position.
      match /class_ranks/{rankId} {
        allow read: if isAdmin(schoolId)
                    || isTeacher(schoolId)
                    || (isStudent(schoolId) && resource.data.admissionNo == myProfile().admissionNo);
        allow write: if isAdmin(schoolId);
      }
    }
  }
}
