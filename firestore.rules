rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function mySchoolId() {
      return myProfile().schoolId;
    }

    function myRole() {
      return myProfile().role;
    }

    function isSameSchool(schoolId) {
      return isSignedIn() && mySchoolId() == schoolId;
    }

    function isAdmin(schoolId) {
      return isSameSchool(schoolId) && myRole() in ['admin', 'superadmin'];
    }

    function isTeacher(schoolId) {
      return isSameSchool(schoolId) && myRole() == 'teacher';
    }

    function isStudent(schoolId) {
      return isSameSchool(schoolId) && myRole() == 'student';
    }

    // Platform admin = a small, manually-managed allowlist (never created
    // via the app itself) used only to activate paid subscriptions across
    // ALL schools. This is intentionally separate from any school's own
    // admin role.
    function isPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    // ---- platform_admins: read-only-of-self, never writable from the
    // client at all — only ever set up manually in the Firebase console. ----
    match /platform_admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- users: a user can read/update only their own profile.
    // Accounts are created in one of two ways:
    //  1. An existing admin bulk-creates student/teacher accounts for
    //     their own school.
    //  2. Self-onboarding: someone registers as the founding admin of a
    //     BRAND NEW school. This is only allowed if the referenced school
    //     document already records THEM as its creator (see the schools
    //     create rule below) — so this can never be used to attach an
    //     admin identity to an existing school. ----
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if request.auth != null
                    && (
                      (isAdmin(request.resource.data.schoolId)
                        && request.resource.data.role in ['student', 'teacher'])
                      ||
                      (request.auth.uid == uid
                        && request.resource.data.role == 'admin'
                        && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.createdBy == request.auth.uid)
                    );
      allow update: if (isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.schoolId == resource.data.schoolId
                    && request.resource.data.get('admissionNo', null) == resource.data.get('admissionNo', null)
                    && request.resource.data.get('classIds', null) == resource.data.get('classIds', null))
                    || (isAdmin(resource.data.schoolId)
                        && resource.data.role == 'teacher'
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.schoolId == resource.data.schoolId);
      allow delete: if false;
    }

    // ---- school_directory: the ONLY publicly-readable school data —
    // just {name}, nothing else. This exists purely so the login page's
    // school picker can work before anyone is authenticated. Every real
    // school detail (branding, subscription dates, who created it) lives
    // in /schools instead, which is NOT public. Kept in sync by the app
    // whenever a school is created or its name changes. ----
    match /school_directory/{schoolId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && get(/databases/$(database)/documents/schools/$(schoolId)).data.createdBy == request.auth.uid;
      allow update: if isAdmin(schoolId) || isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // ---- schools: full record — branding, subscription, creator.
    // Only readable by that school's own members or a platform admin —
    // NOT public (see school_directory above for what public visitors
    // can see instead).
    // Create: anyone signed in can create a BRAND NEW school (Firestore's
    // create semantics already forbid overwriting an existing doc), as
    // long as they mark themselves as its creator — this is what the
    // self-onboarding flow uses, and it's what the users/{uid} admin
    // self-registration above checks against.
    // Update: only that school's own admin, or a platform admin
    // (subscription activation). ----
    match /schools/{schoolId} {
      allow read: if isSameSchool(schoolId) || isPlatformAdmin();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin(schoolId) || isPlatformAdmin();
      allow delete: if isPlatformAdmin();

      match /roster_students/{admissionNo} {
        allow read: if isAdmin(schoolId)
                    || isTeacher(schoolId)
                    || (isStudent(schoolId) && resource.data.claimedByUid == request.auth.uid);
        allow write: if isAdmin(schoolId);
      }

      match /roster_teachers/{staffId} {
        allow read: if isAdmin(schoolId)
                    || (isTeacher(schoolId) && resource.data.claimedByUid == request.auth.uid);
        allow write: if isAdmin(schoolId);
      }

      match /classes/{classId} {
        allow read: if isSameSchool(schoolId);
        allow write: if isAdmin(schoolId);
      }

      match /subjects/{subjectId} {
        allow read: if isSameSchool(schoolId);
        allow write: if isAdmin(schoolId);
      }

      match /results/{resultId} {
        allow read: if isAdmin(schoolId)
                    || isTeacher(schoolId)
                    || (isStudent(schoolId)
                        && resource.data.status == 'published'
                        && resource.data.studentAdmissionNo == myProfile().admissionNo);

        allow create: if isAdmin(schoolId)
                    || (isTeacher(schoolId)
                        && request.resource.data.status != 'published'
                        && request.resource.data.classId in myProfile().classIds);

        allow update: if isAdmin(schoolId)
                    || (isTeacher(schoolId)
                        && resource.data.status != 'published'
                        && request.resource.data.classId in myProfile().classIds);

        allow delete: if isAdmin(schoolId);
      }

      match /announcements/{id} {
        allow read: if isSameSchool(schoolId);
        allow write: if isAdmin(schoolId);
      }

      match /class_ranks/{rankId} {
        allow read: if isAdmin(schoolId)
                    || isTeacher(schoolId)
                    || (isStudent(schoolId) && resource.data.admissionNo == myProfile().admissionNo);
        allow write: if isAdmin(schoolId);
      }
    }
  }
}
